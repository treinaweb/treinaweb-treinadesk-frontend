# Copie para .env.local (desenvolvimento) e .env.e2e (testes E2E).
# Nenhum destes arquivos reais é versionado.

# URL base da API TreinaDesk. Somente servidor: nunca use NEXT_PUBLIC_*.
API_BASE_URL=http://localhost:3000

# --- Somente .env.e2e ---
# Porta em que o Playwright sobe o Next (a API já ocupa a 3000).
E2E_PORT=3100

# Usuários fixos existentes na API (um por papel). Preencha só no .env.e2e.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SUPPORT_EMAIL=
E2E_SUPPORT_PASSWORD=
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
